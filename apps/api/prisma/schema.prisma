generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  role         UserRole
  displayName  String
  qrTokenHash  String?   @unique
  qrTokenRaw   String?   @unique
  loginCode    String?   @unique
  email        String?   @unique
  passwordHash String?
  birthYear    Int?
  classId      String?
  sessionTemplateId String?

  class        Class?             @relation("ClassStudents", fields: [classId], references: [id])
  sessionTemplate SessionTemplate? @relation("StudentSessionTemplate", fields: [sessionTemplateId], references: [id])
  teacherOf    Class[]            @relation("TeacherClasses")
  groupMembers GroupMember[]
  progress     UserProgress?
  diagnostics  DiagnosticResult[]
  sessions     TrainingSession[]
  sessionTemplates SessionTemplate[]
  createdAt    DateTime           @default(now())
}

enum UserRole {
  CHILD
  TEACHER
  ADMIN
}

model Class {
  id                String   @id @default(uuid())
  name              String
  schoolYear        String
  teacherId         String
  sessionTemplateId String?

  teacher         User             @relation("TeacherClasses", fields: [teacherId], references: [id])
  sessionTemplate SessionTemplate? @relation(fields: [sessionTemplateId], references: [id])
  students        User[]           @relation("ClassStudents")
  groups          Group[]
  createdAt       DateTime         @default(now())
}

model Group {
  id      String @id @default(uuid())
  name    String
  classId String

  class   Class         @relation(fields: [classId], references: [id])
  members GroupMember[]
}

model GroupMember {
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
}

model Text {
  id           String @id @default(uuid())
  title        String
  content      String
  wordCount    Int
  lixScore     Float
  targetLevel  Int
  estimatedSec Int

  questions      TextQuestion[]
  clozeTemplate  ClozeTemplate?
  exerciseRuns   ExerciseRun[]
  createdAt      DateTime        @default(now())

  @@unique([title, targetLevel])
}

model TextQuestion {
  id           String @id @default(uuid())
  textId       String
  question     String
  options      Json
  correctIndex Int
  orderIndex   Int

  text Text @relation(fields: [textId], references: [id], onDelete: Cascade)
}

model Diagnostic {
  id               String         @id @default(uuid())
  type             DiagnosticType
  name             String
  durationSec      Int
  itemCount        Int            @default(24)
  intervalSessions Int?

  items     DiagnosticItem[]
  results   DiagnosticResult[]
  createdAt DateTime           @default(now())
}

enum DiagnosticType {
  ENTRY
  INTERMEDIATE
}

model DiagnosticItem {
  id           String  @id @default(uuid())
  diagnosticId String
  sentence     String
  isNonsense   Boolean
  orderIndex   Int
  difficulty   Int     @default(2)

  diagnostic Diagnostic         @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  answers    DiagnosticAnswer[]

  @@unique([diagnosticId, sentence])
}

model DiagnosticResult {
  id           String    @id @default(uuid())
  userId       String
  diagnosticId String
  startedAt    DateTime
  finishedAt   DateTime?
  correctCount Int       @default(0)
  wrongCount   Int       @default(0)
  skippedCount Int       @default(0)
  estimatedWpm Float?

  user       User             @relation(fields: [userId], references: [id])
  diagnostic Diagnostic       @relation(fields: [diagnosticId], references: [id])
  answers    DiagnosticAnswer[]
}

model DiagnosticAnswer {
  id             String     @id @default(uuid())
  resultId       String
  itemId         String
  answer         AnswerType
  responseTimeMs Int
  isCorrect      Boolean

  result DiagnosticResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  item   DiagnosticItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

enum AnswerType {
  TRUE
  FALSE
  SKIP
}

model TrainingSession {
  id              String        @id @default(uuid())
  userId          String
  templateId      String?
  startedAt       DateTime
  finishedAt      DateTime?
  totalDurationMs Int?
  completed       Boolean       @default(false)
  starsEarned     Int?
  trainingUnitId  String?

  user         User             @relation(fields: [userId], references: [id])
  template     SessionTemplate? @relation(fields: [templateId], references: [id])
  exerciseRuns ExerciseRun[]
}

model ExerciseRun {
  id              String       @id @default(uuid())
  sessionId       String
  exerciseType    ExerciseType
  orderIndex      Int
  startedAt       DateTime
  finishedAt      DateTime?
  durationMs      Int?

  textId          String?
  targetWpm       Int?
  flashDurationMs Int?
  flashDifficulty Int?

  itemsTotal      Int          @default(0)
  itemsCorrect    Int          @default(0)
  measuredWpm     Float?
  responses       Json

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text    Text?           @relation(fields: [textId], references: [id])
}

enum ExerciseType {
  FADING
  FLASH_WORD
  CLOZE
  SELF_PACED
}

model FlashWord {
  id              String   @id @default(uuid())
  word            String   @unique
  syllables       Int
  difficultyLevel Int
  distractors     Json
  createdAt       DateTime @default(now())
}

model ClozeTemplate {
  id          String        @id @default(uuid())
  textId      String        @unique
  strategy    ClozeStrategy
  gapInterval Int?

  text Text       @relation(fields: [textId], references: [id])
  gaps ClozeGap[]
}

enum ClozeStrategy {
  AUTO_EVERY_N
  MANUAL
}

model ClozeGap {
  id          String        @id @default(uuid())
  templateId  String
  wordIndex   Int
  correctWord String
  distractors Json

  template ClozeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model SessionTemplate {
  id        String            @id @default(uuid())
  name      String
  isDefault Boolean           @default(false)
  blocks    Json
  teacherId String?
  teacher   User?             @relation(fields: [teacherId], references: [id])
  sessions  TrainingSession[]
  classes   Class[]
  studentOverrides User[]     @relation("StudentSessionTemplate")
  createdAt DateTime          @default(now())

  @@index([teacherId])
}

model UserProgress {
  userId                       String    @id
  fadingTargetWpm              Int
  selfPacedAvgWpm              Float?
  flashWordLevel               Int       @default(1)
  flashWordDurationMs          Int       @default(500)
  clozeAccuracy                Float?
  fadingSessionsSinceIncrease  Int       @default(0)
  flashSessionsSinceIncrease   Int       @default(0)
  clozeSessionsSinceIncrease   Int       @default(0)
  lastIntermediateDiagnosticAt DateTime?
  totalSessions                Int       @default(0)
  averageQuizAccuracy          Float?
  starCount                    Int       @default(0)
  streakDays                   Int       @default(0)
  lastSessionDate              DateTime?
  updatedAt                    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// DSGVO: Audit-Log für sensible Aktionen
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String?
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
