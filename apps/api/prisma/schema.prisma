generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  role         UserRole
  displayName  String
  qrTokenHash  String?   @unique
  email        String?   @unique
  passwordHash String?
  birthYear    Int?
  classId      String?

  class        Class?             @relation("ClassStudents", fields: [classId], references: [id])
  teacherOf    Class[]            @relation("TeacherClasses")
  groupMembers GroupMember[]
  progress     UserProgress?
  diagnostics  DiagnosticResult[]
  sessions     TrainingSession[]
  createdAt    DateTime           @default(now())
}

enum UserRole {
  CHILD
  TEACHER
  ADMIN
}

model Class {
  id         String   @id @default(uuid())
  name       String
  schoolYear String
  teacherId  String

  teacher  User      @relation("TeacherClasses", fields: [teacherId], references: [id])
  students User[]    @relation("ClassStudents")
  groups   Group[]
  createdAt DateTime @default(now())
}

model Group {
  id      String @id @default(uuid())
  name    String
  classId String

  class   Class         @relation(fields: [classId], references: [id])
  members GroupMember[]
}

model GroupMember {
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
}

model Text {
  id           String @id @default(uuid())
  title        String
  content      String
  wordCount    Int
  lixScore     Float
  targetLevel  Int
  estimatedSec Int

  questions TextQuestion[]
  sessions  TrainingSession[]
  createdAt DateTime          @default(now())
}

model TextQuestion {
  id           String @id @default(uuid())
  textId       String
  question     String
  options      Json
  correctIndex Int
  orderIndex   Int

  text Text @relation(fields: [textId], references: [id], onDelete: Cascade)
}

model Diagnostic {
  id          String         @id @default(uuid())
  type        DiagnosticType
  name        String
  durationSec Int

  items     DiagnosticItem[]
  results   DiagnosticResult[]
  createdAt DateTime           @default(now())
}

enum DiagnosticType {
  ENTRY
  INTERMEDIATE
}

model DiagnosticItem {
  id           String  @id @default(uuid())
  diagnosticId String
  sentence     String
  isNonsense   Boolean
  orderIndex   Int

  diagnostic Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
}

model DiagnosticResult {
  id           String    @id @default(uuid())
  userId       String
  diagnosticId String
  startedAt    DateTime
  finishedAt   DateTime?
  correctCount Int       @default(0)
  wrongCount   Int       @default(0)
  skippedCount Int       @default(0)
  estimatedWpm Float?

  user       User             @relation(fields: [userId], references: [id])
  diagnostic Diagnostic       @relation(fields: [diagnosticId], references: [id])
  answers    DiagnosticAnswer[]
}

model DiagnosticAnswer {
  id             String     @id @default(uuid())
  resultId       String
  itemId         String
  answer         AnswerType
  responseTimeMs Int
  isCorrect      Boolean

  result DiagnosticResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
}

enum AnswerType {
  TRUE
  FALSE
  SKIP
}

model TrainingSession {
  id              String    @id @default(uuid())
  userId          String
  textId          String
  targetWpm       Int
  fadingMsBase    Int
  fadingMsPerChar Int
  startedAt       DateTime
  finishedAt      DateTime?
  durationMs      Int?
  completed       Boolean   @default(false)

  user    User            @relation(fields: [userId], references: [id])
  text    Text            @relation(fields: [textId], references: [id])
  answers SessionAnswer[]
}

model SessionAnswer {
  id             String @id @default(uuid())
  sessionId      String
  questionId     String
  selectedIndex  Int
  isCorrect      Boolean
  responseTimeMs Int

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model UserProgress {
  userId                       String    @id
  currentTargetWpm             Int
  sessionsSinceLastIncrease    Int       @default(0)
  lastIntermediateDiagnosticAt DateTime?
  totalSessions                Int       @default(0)
  averageQuizAccuracy          Float?
  updatedAt                    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// DSGVO: Audit-Log für sensible Aktionen
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String?
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}
