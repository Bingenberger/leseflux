{
  "name": "@leseflux/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format cjs --out-dir dist",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "seed:texts": "tsx scripts/seedTexts.ts",
    "seed:templates": "tsx scripts/seedTemplates.ts",
    "seed:flash-words": "tsx scripts/seedFlashWords.ts",
    "seed:cloze-templates": "tsx scripts/seedClozeTemplates.ts",
    "migrate:v1-to-v2": "tsx scripts/migrate-v1-to-v2.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.0.0",
    "@leseflux/shared": "*",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "fastify": "^5.0.0",
    "fastify-plugin": "^4.5.1",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.20.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
